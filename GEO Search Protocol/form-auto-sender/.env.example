# コピーして .env を作成（実値は入れない）
SENDER_EMAIL=
SENDER_PHONE=
SENDER_POSTAL_CODE=
SENDER_PREFECTURE=
SENDER_ADDRESS_FULL=
SENDER_ADDRESS_LINE1=
SENDER_ADDRESS_LINE2=
ANTHROPIC_API_KEY=

# Personalized Preview — Upstash Redis REST (shared with Agent Readiness /api/preview)
# Create at https://console.upstash.com/ → REST API credentials
PREVIEW_STORE_BACKEND=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: PREVIEW_STORE_KEY_PREFIX=preview:
# Optional: PREVIEW_STORE_TTL_SECONDS=7776000
# Local dev ONLY (never on Vercel): PREVIEW_STORE_ALLOW_FILESYSTEM=1
